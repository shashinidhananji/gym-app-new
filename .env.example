# Copy to .env and fill in. Only VITE_-prefixed vars reach the browser.
# The anon key is safe to expose; it is constrained by row level security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key (safe to expose). The secret key belongs in
# Supabase Edge Function secrets, never here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
